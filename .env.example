# ============================================================
# Cashback Engine — Environment Variables
# These defaults work out of the box for local/dev deployment.
# For production, replace passwords and secrets below.
# ============================================================

# PostgreSQL — defaults work as-is
POSTGRES_DB=cashbackengine
POSTGRES_USER=cashback_user
POSTGRES_PASSWORD=cashback_pass

# Spring Boot Service
SERVICE_PORT=8080
JWT_SECRET=Y2FzaGJhY2tlbmdpbmVzdXBlcnNlY3JldGp3dGtleTMyY2hhcnNsb25n
JWT_EXPIRATION_MS=86400000

# Mail — leave as-is if you don't need email features
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@cashbackengine.com
MAIL_PASSWORD=changeme

# UI port
UI_PORT=80

# CORS — add your domain here for production
# Example: https://cashwapas.com,https://www.cashwapas.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80
