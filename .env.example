# ============================================================
# Cashback Engine — Environment Variables
# Copy this file to .env and fill in real values before deploy
# ============================================================

# PostgreSQL
POSTGRES_DB=cashbackengine
POSTGRES_USER=cashback_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Spring Boot Service
SERVICE_PORT=8080
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHAR_BASE64_SECRET
JWT_EXPIRATION_MS=86400000

# Mail (Gmail: use App Password, not your account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Angular UI
UI_PORT=80

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# App domain (used in nginx)
APP_DOMAIN=yourdomain.com
